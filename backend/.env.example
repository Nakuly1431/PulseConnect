# PulseConnect Environment Configuration

# Database (defaults to SQLite if left empty)
DATABASE_URL=sqlite:///./pulseconnect.db

# JWT Secret Key
SECRET_KEY=pulseconnect-super-secure-emergency-jwt-secret-key-2026

# Real-Time SMS Gateway for Mobile OTP Delivery
# -------------------------------------------------------------
# OPTION 1: Fast2SMS (Recommended for India - Free credits, zero DLT paperwork for Quick OTP)
# Get free API key at: https://www.fast2sms.com
FAST2SMS_API_KEY=

# OPTION 2: Twilio (Global SMS)
# Get credentials at: https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Emergency Matching Radius (km)
NOTIFICATION_RADIUS_KM=15.0
