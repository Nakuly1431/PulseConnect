# ==============================================================================
# PulseConnect - .gitignore
# Clean, organized rules for Python, Node.js, OS, IDEs, and Environment Secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL: Never commit secrets)
# ------------------------------------------------------------------------------
.env
.env.*
.env*.local
*.env
!.env.example

# ------------------------------------------------------------------------------
# 2. Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ------------------------------------------------------------------------------
# 3. Code Editors & IDEs
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains (PyCharm, WebStorm, IntelliJ)
.idea/
*.iws
*.iml
*.ipr

# Miscellaneous Editors
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 4. Backend (Python & FastAPI)
# ------------------------------------------------------------------------------
# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Distribution & Build artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage caches
.pytest_cache/
.coverage
htmlcov/
.tox/

# ------------------------------------------------------------------------------
# 5. Frontend (React, Vite & Node.js)
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
frontend/node_modules/

# Production build outputs
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/

# Local cache
.eslintcache
.vite/
frontend/.vite/

# ------------------------------------------------------------------------------
# 6. Database & User Uploads
# ------------------------------------------------------------------------------
# SQLite temporary files (keep main database or seed files)
*.db-journal
*.db-wal
*.db-shm

# User uploaded files (keep .gitkeep placeholder)
backend/uploads/*
!backend/uploads/.gitkeep

# ------------------------------------------------------------------------------
# 7. Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
