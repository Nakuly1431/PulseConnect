# Backend API Base URL
# For local development:
VITE_API_BASE_URL=http://localhost:8000/api

# For production (Vercel):
# Set this in your Vercel Project Dashboard -> Settings -> Environment Variables
# Example: https://pulseconnect-backend.onrender.com/api

# Google Firebase Phone Authentication (10,000 Free Real SMS per Month)
# Get credentials from Firebase Console (https://console.firebase.google.com)
# 1. Create a Firebase project
# 2. Go to Authentication -> Sign-in method -> Phone -> Enable
# 3. Go to Project Settings -> General -> Your apps -> Web app (</>) -> copy firebaseConfig
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
